; Engine configuration file.
config_version=5

[application]

config/name="Don't Get Wet"
config/description="Keep dry in a city where it never stops raining. A game by Peter Wells."
config/version="0.2.0"
run/main_scene="res://src/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

Tun="*res://src/core/tunables.gd"
Inputs="*res://src/core/inputs.gd"
Game="*res://src/core/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://src/ui/theme.tres"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="cover"
3d_physics/layer_3="player"
3d_physics/layer_4="umbrella"

[physics]

common/physics_ticks_per_second=60

[rendering]

environment/defaults/default_clear_color=Color(0, 0, 0, 1)

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/volumetric_fog/volume_size=96
textures/canvas_textures/default_texture_filter=2
