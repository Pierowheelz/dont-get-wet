class_name UIStyle
extends RefCounted
## Shared palette, fonts and small helpers for every UI screen. The project Theme
## (res://src/ui/theme.tres, generated by theme_gen.gd) uses the same values.

# Palette: wet night, sodium lamps, cold rain light, a little neon toward the city centre.
const INK := Color(0.035, 0.04, 0.055)
const PANEL := Color(0.055, 0.062, 0.078, 0.94)
const CREAM := Color(0.94, 0.91, 0.84)
const MUTED := Color(0.94, 0.91, 0.84, 0.58)
const AMBER := Color(1.0, 0.71, 0.29)        # sodium lamp / focus colour
const AMBER_DIM := Color(0.62, 0.43, 0.18)
const RAIN := Color(0.42, 0.66, 1.0)
const RAIN_DEEP := Color(0.16, 0.32, 0.62)
const NEON_TEAL := Color(0.3, 1.0, 0.9)
const NEON_PINK := Color(1.0, 0.32, 0.62)
const DANGER := Color(0.96, 0.31, 0.25)
const GOOD := Color(0.55, 0.9, 0.55)
const GOLD := Color(1.0, 0.84, 0.38)

const F_TITLE := preload("res://assets/fonts/BebasNeue-Regular.ttf")
const F_BODY := preload("res://assets/fonts/Barlow-Medium.ttf")
const F_BODY_REG := preload("res://assets/fonts/Barlow-Regular.ttf")
const F_BOLD := preload("res://assets/fonts/Barlow-SemiBold.ttf")
const F_ITALIC := preload("res://assets/fonts/Barlow-Italic.ttf")
const F_COND := preload("res://assets/fonts/BarlowCondensed-SemiBold.ttf")
const F_SIGN := preload("res://assets/fonts/sign.ttf")

const GRADE_COLORS := {"S": GOLD, "A": GOOD, "B": RAIN, "C": Color(0.8, 0.72, 0.62)}


static func grade_color(g: String) -> Color:
	return GRADE_COLORS.get(g, CREAM)


static func fmt_time(t: float, tenths := false) -> String:
	if tenths:
		return "%d:%04.1f" % [floori(t / 60.0), fmod(t, 60.0)]
	return "%d:%02d" % [floori(t / 60.0), int(t) % 60]


## A label with a theme type variation and optional overrides.
static func label(text: String, variation: StringName = &"", size := 0, color := Color(0, 0, 0, 0)) -> Label:
	var l := Label.new()
	l.text = text
	if variation != &"":
		l.theme_type_variation = variation
	if size > 0:
		l.add_theme_font_size_override("font_size", size)
	if color.a > 0.0:
		l.add_theme_color_override("font_color", color)
	return l


## Draws a small umbrella glyph (canopy + shaft + hook) centred at `c`, canopy width `w`.
static func draw_umbrella(ci: CanvasItem, c: Vector2, w: float, col: Color, open := 1.0) -> void:
	var r := w * 0.5 * lerpf(0.35, 1.0, open)
	var top := c + Vector2(0, -w * 0.32)
	var pts := PackedVector2Array()
	var n := 18
	for i in n + 1:
		var a := PI + PI * float(i) / float(n)
		pts.append(top + Vector2(cos(a) * r, sin(a) * r * 0.78))
	# scalloped rim
	var scallops := 4
	for i in range(scallops, -1, -1):
		var x := -r + 2.0 * r * float(i) / float(scallops)
		pts.append(top + Vector2(x, w * 0.02 if i % 2 == 0 else w * 0.07))
	ci.draw_colored_polygon(pts, col)
	ci.draw_line(top + Vector2(0, -r * 0.78 - w * 0.06), top + Vector2(0, -r * 0.78), col, maxf(1.5, w * 0.05), true)
	var shaft_end := c + Vector2(0, w * 0.42)
	ci.draw_line(top, shaft_end, col, maxf(1.5, w * 0.05), true)
	ci.draw_arc(shaft_end + Vector2(-w * 0.07, 0), w * 0.07, 0.0, PI, 10, col, maxf(1.5, w * 0.05), true)


## Draws a water drop centred at `c` with height `h`, filled to `fill` (0..1) with `fill_col`.
static func draw_drop(ci: CanvasItem, c: Vector2, h: float, outline: Color, fill_col: Color, fill := 1.0) -> void:
	var pts := drop_points(c, h)
	ci.draw_colored_polygon(pts, Color(0, 0, 0, 0.35))
	if fill > 0.01:
		var cut := c.y + h * 0.5 - h * clampf(fill, 0.0, 1.0)
		var below := PackedVector2Array([Vector2(c.x - h, cut), Vector2(c.x + h, cut), Vector2(c.x + h, c.y + h), Vector2(c.x - h, c.y + h)])
		for fp in Geometry2D.intersect_polygons(pts, below):
			# Skip degenerate slivers (triangulation fails on near-zero-area polygons).
			if fp.size() >= 3 and absf(_area(fp)) > 2.0:
				ci.draw_colored_polygon(fp, fill_col)
	var closed := pts.duplicate()
	closed.append(pts[0])
	ci.draw_polyline(closed, outline, maxf(1.5, h * 0.07), true)
	# highlight
	ci.draw_arc(c + Vector2(-h * 0.1, h * 0.12), h * 0.16, PI * 0.9, PI * 1.35, 6, Color(1, 1, 1, 0.55), maxf(1.0, h * 0.05), true)


static func _area(pts: PackedVector2Array) -> float:
	var a := 0.0
	for i in pts.size():
		var p := pts[i]
		var q := pts[(i + 1) % pts.size()]
		a += p.x * q.y - q.x * p.y
	return a * 0.5


static func drop_points(c: Vector2, h: float) -> PackedVector2Array:
	var r := h * 0.32
	var cc := c + Vector2(0, h * 0.5 - r)
	var tip := c + Vector2(0, -h * 0.5)
	var pts := PackedVector2Array()
	pts.append(tip)
	var a0 := -PI * 0.5 + 0.62
	var a1 := PI * 1.5 - 0.62
	var n := 16
	for i in n + 1:
		var a := a0 + (a1 - a0) * float(i) / float(n)
		pts.append(cc + Vector2(cos(a), sin(a)) * r)
	return pts


## Inn / shelter icon: a little house with a lit window, base centre at `c`.
static func draw_inn(ci: CanvasItem, c: Vector2, s: float, col: Color, lit: Color) -> void:
	var body := Rect2(c.x - s * 0.4, c.y - s * 0.55, s * 0.8, s * 0.55)
	ci.draw_rect(body, col)
	ci.draw_colored_polygon(PackedVector2Array([
		Vector2(c.x - s * 0.52, c.y - s * 0.52), Vector2(c.x, c.y - s * 0.95), Vector2(c.x + s * 0.52, c.y - s * 0.52)]), col)
	ci.draw_rect(Rect2(c.x - s * 0.11, c.y - s * 0.4, s * 0.22, s * 0.22), lit)


## Little walking man (stick figure in a coat) for progress bars / map markers; base at `c`.
static func draw_walker(ci: CanvasItem, c: Vector2, s: float, col: Color, phase: float) -> void:
	var w := maxf(1.5, s * 0.1)
	var hip := c + Vector2(0, -s * 0.42)
	var neck := c + Vector2(0, -s * 0.8)
	var sw := sin(phase) * s * 0.16
	ci.draw_line(hip, c + Vector2(sw, 0), col, w, true)
	ci.draw_line(hip, c + Vector2(-sw, 0), col, w, true)
	ci.draw_line(hip, neck, col, w * 1.4, true)
	ci.draw_circle(neck + Vector2(0, -s * 0.11), s * 0.1, col)
	# arm up holding the umbrella
	var hand := neck + Vector2(s * 0.12, -s * 0.08)
	ci.draw_line(neck + Vector2(0, s * 0.05), hand, col, w, true)
	draw_umbrella(ci, hand + Vector2(0, -s * 0.28), s * 0.75, col)
