 "set_pieces": [
  {"name": "The shops", "x0": 0.0, "x1": 36.0, "teaches": "a covered start under the shut shops' verandas, then the first front gardens"},
  {"name": "The first street tree", "x0": 36.0, "x1": 75.0, "teaches": "trees keep off most of the rain but not all, then a 14 m sun break to dry in"},
  {"name": "The overbridge", "x0": 75.0, "x1": 98.5, "teaches": "the railway bridge over the street, and a broken downpipe off it to fill the umbrella at"},
  {"name": "Under the plane trees", "x0": 98.5, "x1": 164.5, "teaches": "28 m of street trees to rest under with the umbrella shut, 15 m of sun by the flats, then the first gust, which shakes the trees' water down (umbrella up, upright)"},
  {"name": "The open street", "x0": 164.5, "x1": 240.5, "teaches": "a man running up from behind for one shot in the park's sun, Fairweather's car with no lights through the deep puddle, then a second runner as the sun comes out"},
  {"name": "St Michael's hall", "x0": 240.5, "x1": 288.5, "teaches": "the hall's porch along its front, a short sun break, and a gust under the gums"},
  {"name": "The bus shelter", "x0": 288.5, "x1": 353.5, "teaches": "a sun break, Fairweather's second pass across open footpath, the shelter, then 20 m of sun"},
  {"name": "The Royal", "x0": 353.5, "x1": 424.5, "teaches": "the strongest gust under the last trees, the suburb thinning toward the country, his last pass, and the pub door"}
 ],
