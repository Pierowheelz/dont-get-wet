 "set_pieces": [
  {"name": "Hollis Mill and the allotments", "x0": 0.0, "x1": 77.0, "teaches": "walk the mill yard under tin, open for two short gaps (3 and 5 m), then the first sun break in a light wind: close it in the 5 m of sun between two short rainy strips"},
  {"name": "Weir Lane", "x0": 77.0, "x1": 131.5, "teaches": "the first long gap (14 m) as the headwind builds, 13 m of cover to recover, a gutter seam, a puddle gap"},
  {"name": "Mill Road Gas", "x0": 131.5, "x1": 202.0, "teaches": "two long gaps into the wind (the 15 m kiln yard, then the loading dock and Quarry Road, 18 m with a car), then the one big breather: canopy, kiosk and the warm garage"},
  {"name": "The Long Field", "x0": 202.0, "x1": 276.0, "teaches": "open field where the sun breaks are the only rest: close in each, reopen in time. 23 m with one break, the barn and its gutter, then 25 m with two"},
  {"name": "The last mile", "x0": 276.0, "x1": 414.0, "teaches": "full headwind: torn tin and gutters at the junkyard, County Line (car), the torn motel, a last field split by a tin shed, a gutter at the Roadhouse door"}
