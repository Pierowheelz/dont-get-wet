 "gusts": true,
 "set_pieces": [
  {"name": "The station arches", "x0": 0.0, "x1": 28.0, "teaches": "walk dry under the first run of arches, then across Yard Lane in front of a black sedan idling there, wipers going"},
  {"name": "The first girders", "x0": 28.0, "x1": 100.5, "teaches": "the first open girder span: short gaps that rain and the train's sheet fall through, the only sun break, a gutter seam, then more arches and Station Lane's car"},
  {"name": "The first man", "x0": 100.5, "x1": 148.5, "teaches": "footsteps and a long shadow from behind, then a man in the walker's own suit who closes in and fires: tilt back to block his jets, or reach the arches, where he holds his fire"},
  {"name": "The sidings", "x0": 148.5, "x1": 218.0, "teaches": "longer gaps into the tailwind, a gutter seam, torn tin with a gutter through the tear, then arches"},
  {"name": "The second man", "x0": 218.0, "x1": 268.0, "teaches": "the second man along gaps and torn tin, then two arches before Market Street's car"},
  {"name": "The goods yard", "x0": 268.0, "x1": 327.5, "teaches": "the wind turns into a headwind: gaps, torn tin with a gutter, a gutter seam and a 12 m clearing"},
  {"name": "The third man", "x0": 327.5, "x1": 375.5, "teaches": "the third man in the headwind, where tilting back to block him lets the rain in front"},
  {"name": "The Railway Arms", "x0": 375.5, "x1": 450.0, "teaches": "long gaps into the headwind with gutters, Mill Lane's car and the inn"}
 ],
