 "gusts": true,
 "set_pieces": [
  {"name": "The Telstar Arcade", "x0": 0.0, "x1": 25.0, "teaches": "walking under continuous awnings past finned kiosks and the first ringing payphone while the first trains pass overhead: the awnings keep their sheet off"},
  {"name": "The Parade Viaduct", "x0": 78.5, "x1": 107.5, "teaches": "the first deck: cover from the rain, but each train sheds its sheet onto the bare stretches beneath it. Wait under an awning, hurry through, or hold the umbrella upright"},
  {"name": "Orbit Avenue", "x0": 112.5, "x1": 193.0, "teaches": "open lots, a gutter and a car crossing as the tailwind rises, with trains washing the open sky and the side street too: tilting into the wind and straightening up for the train pull against each other"},
  {"name": "The Express Viaduct", "x0": 193.0, "x1": 266.4, "teaches": "a second deck over longer bare stretches, then two gutters in googie seams under the track"},
  {"name": "The Junction Viaduct", "x0": 266.4, "x1": 361.4, "teaches": "the wind turns into a headwind under the deck; then a torn marquee, a gutter and Sputnik Street's car, with the sheet crossing the side street"},
  {"name": "Telstar Station", "x0": 364.4, "x1": 422.59999999999997, "teaches": "the last span: the station stairs with a phone that keeps ringing beneath them, a deep puddle, the inn"}
 ],
