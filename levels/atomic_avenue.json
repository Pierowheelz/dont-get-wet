  {"name": "Atom Plaza", "x0": 0.0, "x1": 42.5, "teaches": "continuous canopies, then a man in a doorway steps out under a yellow umbrella: keep him in frame and hang back. Two short gaps between stores"},
  {"name": "Halcyon's", "x0": 42.5, "x1": 84.0, "teaches": "his first window stop: the walker has to stop well short of him (hold stop), then gaps between stores and a gutter, at his pace rather than the walker's"},
  {"name": "Fission Street", "x0": 84.0, "x1": 140.0, "teaches": "open road and the Kelvin & Co. windows: stopping behind him in the open, umbrella up"},
  {"name": "Nucleon Square", "x0": 140.0, "x1": 197.5, "teaches": "his longest window stop, wider gaps and a gutter as the rain and wind rise"},
  {"name": "Isotope Row", "x0": 197.5, "x1": 240.0, "teaches": "gaps between every store and a gutter: keeping him in frame while the umbrella stays up"},
  {"name": "Positron Street", "x0": 240.0, "x1": 315.2, "teaches": "the last stores and windows; he goes into the inn just ahead of the walker"}
