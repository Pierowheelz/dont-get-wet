  {"name": "Atom Plaza", "x0": 0.0, "x1": 42.5, "teaches": "continuous canopies, then a man in a doorway steps out under a yellow umbrella: keep him in frame and hang back. Two short gaps between stores"},
  {"name": "Halcyon's", "x0": 42.5, "x1": 84.0, "teaches": "his first window stop: the walker has to stop well short of him (hold stop), then gaps between stores and a gutter, at his pace rather than the walker's"},
  {"name": "Fission Street", "x0": 101.0, "x1": 157.0, "teaches": "open road and the Kelvin & Co. windows: stopping behind him in the open, umbrella up"},
  {"name": "Nucleon Square", "x0": 157.0, "x1": 214.5, "teaches": "his longest window stop, wider gaps and a gutter as the rain and wind rise"},
  {"name": "Isotope Row", "x0": 214.5, "x1": 281.0, "teaches": "gaps between every store and a gutter: keeping him in frame while the umbrella stays up"},
  {"name": "The Electron Arcade", "x0": 281.0, "x1": 335.5, "teaches": "two more windows between open lots and a gutter, the wind at its strongest"},
  {"name": "Positron Street", "x0": 335.5, "x1": 414.7, "teaches": "the last stores and windows; he goes into the inn just ahead of the walker"}
 ],
