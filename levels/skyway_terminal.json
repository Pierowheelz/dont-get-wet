 "gusts": false,
 "set_pieces": [
  {"name": "Terminal Approach", "x0": 0.0, "x1": 44.0, "teaches": "the first skyway, dry underfoot with the wider camera; the first helicopter comes in low from ahead and its rotor wash drives the rain in under the skyway: umbrella up, upright"},
  {"name": "The Concourse", "x0": 44.0, "x1": 84.5, "teaches": "the skyway breaks off for short gaps and a downpipe, then carries on over Jetway Street, whose car comes at a walker under cover"},
  {"name": "Tailing Fairweather", "x0": 84.5, "x1": 231.5, "teaches": "the man in the yellow slicker steps out of the travel bureau and walks to the terminal under the skyway, stopping at four windows: keep him in frame, out of his glance, hide your face when he looks round; two plazas in the rain, and Runway Street"},
  {"name": "At the terminal door", "x0": 213.5, "x1": 233.0, "teaches": "a helicopter coming in to land on the terminal roof as he goes in: umbrella up for the wash"},
  {"name": "His Men", "x0": 233.0, "x1": 268.5, "teaches": "two men posted under the skyway, downpipes before and after them to refill the shot"},
  {"name": "The Hover", "x0": 268.5, "x1": 298.0, "teaches": "a helicopter overtakes and hangs over the skyway: hold the canopy up through the wash until it flies on (the canopy fights the downdraught: stamina drains even standing)"},
  {"name": "Airport Road", "x0": 298.0, "x1": 360.0, "teaches": "plazas open to the sky in heavier rain, and two cars that come up behind: splash from behind, a shot from ahead; skyway again over the approach to Airport Road"},
  {"name": "Skyway Terminal Hotel", "x0": 374.0, "x1": 397.5, "teaches": "a last downpipe, the last of his men at the hotel lobby, and Fairweather's helicopter passing overhead as the walker reaches the door"}
 ],
