 "id": "skyway_terminal",
 "name": "Skyway Terminal",
 "blurb": "Glass towers and skyways over the pavement. The airport helicopters come and go from the terminal roof.",
 "aesthetic": "modern",
 "neon": 0.35,
 "length": 405.5,
 "end_x": 393.5,
 "checkpoints": [85.0, 179.82, 306.27],
 "rain": [[0.0, 1.0], [0.5, 1.15], [1.0, 1.3]],
