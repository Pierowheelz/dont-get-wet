 "set_pieces": [
  {"name": "Terminal Approach", "x0": 0.0, "x1": 44.0, "teaches": "the first skyway, dry underfoot with the wider camera; the first helicopter comes in low from ahead and its rotor wash drives the rain in under the skyway: umbrella up, upright"},
  {"name": "The Concourse", "x0": 44.0, "x1": 74.5, "teaches": "the skyway breaks off: short gaps, a downpipe and a car crossing at Jetway Street"},
  {"name": "Tailing Fairweather", "x0": 74.5, "x1": 229.5, "teaches": "the man in the yellow slicker steps out of the travel bureau and walks to the terminal under the skyway, stopping at three windows: keep him in frame, out of his glance, hide your face when he looks round; a helicopter passes mid-tail and a car crosses at Runway Street"},
  {"name": "His Men", "x0": 229.5, "x1": 282.0, "teaches": "three men posted under the skyway with downpipes to refill the shot between them, and a helicopter that hovers over them: hold the canopy up against the wash or tilt it at a jet"},
  {"name": "Airport Road", "x0": 282.0, "x1": 346.0, "teaches": "plazas open to the sky in heavier rain, and two cars that come up behind: splash from behind, a shot from ahead"},
  {"name": "Skyway Terminal Hotel", "x0": 346.0, "x1": 383.5, "teaches": "the last skyway to the hotel door as Fairweather's helicopter lifts off over the walker"}
 ],
