  {"name": "Kiln Street terraces", "x0": 0.0, "x1": 64.0, "teaches": "walk the terrace under awnings and balconies, open for two short gaps (3 and 4 m), then close in the one sun break inside a 12 m gap"},
  {"name": "The cleared row", "x0": 64.0, "x1": 122.5, "teaches": "the follower's first appearance under cover; a gap with a puddle, a gutter seam beside a torn tin awning, then the last sun break in a 14 m clearing"},
  {"name": "The brickworks", "x0": 122.5, "x1": 200.0, "teaches": "Kiln Lane, the follower again (stop and listen under the brickworks tin), the chimney's gutter, then two kiln yards (15 and 11 m) with a warm lodge between"},
  {"name": "Pit Row", "x0": 200.0, "x1": 272.5, "teaches": "a car crossing after 12 m of cover, torn tin, a gutter seam, then the 14 m clearing to a torn awning with a gutter through its tear"},
  {"name": "The last houses", "x0": 272.5, "x1": 348.0, "teaches": "a 14 m clearing into the full headwind, a gutter seam, torn tin, then 10 and 12 m gaps with 11 m of cover between to catch a breath"},
  {"name": "The Kiln Arms", "x0": 348.0, "x1": 392.0, "teaches": "grey suits standing dry under the last awnings, one more gap, Field Lane (car), and a man on the inn porch facing the door"}
